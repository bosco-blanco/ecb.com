{%- comment -%}
  Aviso de pocas unidades, justo debajo del boton de compra.

  Antes era una caja naranja con los estilos incrustados en el HTML; ahora es
  una linea del sistema de la ficha (clase `ecdb-stock`, estilos en
  assets/ficha-producto-ecdb.css). Misma logica: umbral de 10 unidades sobre
  el stock real de la variante elegida. Tambien se arregla el plural: con una
  unidad decia "Ultimas 1 unidades".

  Uso:
  {% render 'stock-urgency', product: product %}
{%- endcomment -%}

{%- liquid
  assign urgency_threshold = 10
  assign variant = product.selected_or_first_available_variant
  assign qty = variant.inventory_quantity
  assign tracking = variant.inventory_management
-%}

{%- if tracking == 'shopify' and qty > 0 and qty <= urgency_threshold and variant.available -%}
  <p class="ecdb-fp ecdb-stock" role="status">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
    <span>
      {%- if qty == 1 -%}
        <strong>Última unidad</strong> — no dejes escapar esta botella
      {%- elsif qty <= 3 -%}
        <strong>Últimas {{ qty }} unidades</strong> — no dejes escapar esta botella
      {%- elsif qty <= 6 -%}
        <strong>Quedan solo {{ qty }} unidades</strong>
      {%- else -%}
        <strong>Solo {{ qty }} unidades disponibles</strong>
      {%- endif -%}
    </span>
  </p>
{%- endif -%}
