{% unless template == 'index' %}
{% unless template contains 'page' and template contains 'password' %}
{% unless page.handle == 'acceso-ventas-privadas' %}
{%- comment -%}
  Los estilos que antes iban en linea (font-size, colores, separador) viven
  aqui, en clases. Asi la ficha de producto puede vestir las migas a su
  manera desde assets/ficha-producto-ecdb.css sin pelearse con `style=`.
{%- endcomment -%}
{% style %}
  .breadcrumb { font-size: 12px; color: #888; padding: 10px 0 6px; }
  .breadcrumb__list { display: flex; flex-wrap: wrap; align-items: center; gap: 4px; }
  .breadcrumb__link { color: #888; text-decoration: none; }
  .breadcrumb__sep { color: #ccc; font-size: 10px; }
  .breadcrumb__current { color: #555; font-weight: 500; }
{% endstyle %}
<div class="container">
  <nav class="breadcrumb row" role="navigation" aria-label="Migas de pan">
    <div class="col-12 breadcrumb__list" itemscope itemtype="https://schema.org/BreadcrumbList">
      <span itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
        <a href="{{ routes.root_url }}" itemprop="item" class="breadcrumb__link">
          <span itemprop="name">Inicio</span>
        </a>
        <meta itemprop="position" content="1">
      </span>

      {% if template contains 'product' %}
        {% if collection.url %}
          <span class="breadcrumb__sep" aria-hidden="true">&#8250;</span>
          <span itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
            <a href="{{ collection.url }}" itemprop="item" class="breadcrumb__link">
              <span itemprop="name">{{ collection.title }}</span>
            </a>
            <meta itemprop="position" content="2">
          </span>
          <span class="breadcrumb__sep" aria-hidden="true">&#8250;</span>
          <span itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem" class="breadcrumb__current">
            <span itemprop="name">{{ product.title | truncatewords: 6 }}</span>
            <meta itemprop="item" content="{{ request.origin }}{{ product.url }}">
            <meta itemprop="position" content="3">
          </span>
        {% else %}
          <span class="breadcrumb__sep" aria-hidden="true">&#8250;</span>
          <span itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
            <a href="{{ routes.collections_url }}" itemprop="item" class="breadcrumb__link">
              <span itemprop="name">Vinos</span>
            </a>
            <meta itemprop="position" content="2">
          </span>
          <span class="breadcrumb__sep" aria-hidden="true">&#8250;</span>
          <span itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem" class="breadcrumb__current">
            <span itemprop="name">{{ product.title | truncatewords: 6 }}</span>
            <meta itemprop="item" content="{{ request.origin }}{{ product.url }}">
            <meta itemprop="position" content="3">
          </span>
        {% endif %}

      {% elsif template contains 'collection' and collection.handle %}
        <span class="breadcrumb__sep" aria-hidden="true">&#8250;</span>
        {% if current_tags %}
          <span itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
            {% capture col_url %}/collections/{{ collection.handle }}{% endcapture %}
            <a href="{{ col_url }}" itemprop="item" class="breadcrumb__link">
              <span itemprop="name">{{ collection.title }}</span>
            </a>
            <meta itemprop="position" content="2">
          </span>
          <span class="breadcrumb__sep" aria-hidden="true">&#8250;</span>
          <span itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem" class="breadcrumb__current">
            <span itemprop="name">{{ current_tags | join: " + " }}</span>
            <meta itemprop="position" content="3">
          </span>
        {% else %}
          <span itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem" class="breadcrumb__current">
            <span itemprop="name">{{ collection.title }}</span>
            <meta itemprop="item" content="{{ request.origin }}{{ collection.url }}">
            <meta itemprop="position" content="2">
          </span>
        {% endif %}

      {% elsif template == 'blog' %}
        <span class="breadcrumb__sep" aria-hidden="true">&#8250;</span>
        {% if current_tags %}
          <span itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
            <a href="{{ blog.url }}" itemprop="item" class="breadcrumb__link">
              <span itemprop="name">{{ blog.title }}</span>
            </a>
            <meta itemprop="position" content="2">
          </span>
          <span class="breadcrumb__sep" aria-hidden="true">&#8250;</span>
          <span class="breadcrumb__current">{{ current_tags | join: " + " }}</span>
        {% else %}
          <span itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem" class="breadcrumb__current">
            <span itemprop="name">{{ blog.title }}</span>
            <meta itemprop="item" content="{{ request.origin }}{{ blog.url }}">
            <meta itemprop="position" content="2">
          </span>
        {% endif %}

      {% elsif template == 'article' %}
        <span class="breadcrumb__sep" aria-hidden="true">&#8250;</span>
        <span itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <a href="{{ blog.url }}" itemprop="item" class="breadcrumb__link">
            <span itemprop="name">{{ blog.title }}</span>
          </a>
          <meta itemprop="position" content="2">
        </span>
        <span class="breadcrumb__sep" aria-hidden="true">&#8250;</span>
        <span itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem" class="breadcrumb__current">
          <span itemprop="name">{{ article.title | truncatewords: 6 }}</span>
          <meta itemprop="item" content="{{ request.origin }}{{ article.url }}">
          <meta itemprop="position" content="3">
        </span>

      {% elsif template contains 'search' %}
        <span class="breadcrumb__sep" aria-hidden="true">&#8250;</span>
        <span class="breadcrumb__current">Buscar</span>

      {% elsif template contains 'cart' %}
        <span class="breadcrumb__sep" aria-hidden="true">&#8250;</span>
        <span class="breadcrumb__current">Carrito</span>

      {% else %}
        <span class="breadcrumb__sep" aria-hidden="true">&#8250;</span>
        <span class="breadcrumb__current">{{ page_title }}</span>
      {% endif %}
    </div>
  </nav>
</div>
{% endunless %}
{% endunless %}
{% endunless %}
