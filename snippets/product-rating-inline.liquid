{%- comment -%}
  Estrellas + numero de resenas de Judge.me, para pintar junto al titulo del producto.

  Lee los metafields que Judge.me sincroniza en Shopify:
  - product.metafields.reviews.rating       (tipo rating: .rating, .scale_min, .scale_max)
  - product.metafields.reviews.rating_count (number_integer)

  Si el producto no tiene resenas no pinta absolutamente nada.

  Uso:
  {% render 'product-rating-inline', product: product %}
{%- endcomment -%}

{%- liquid
  assign pri_count = product.metafields.reviews.rating_count | plus: 0
  assign pri_rating_obj = product.metafields.reviews.rating.value
  assign pri_show = false
  if pri_count > 0 and pri_rating_obj != blank and pri_rating_obj.rating != blank
    assign pri_show = true
  endif
-%}

{%- if pri_show -%}
  {%- liquid
    assign pri_value = pri_rating_obj.rating | times: 1.0
    assign pri_max = pri_rating_obj.scale_max | plus: 0
    if pri_max <= 0
      assign pri_max = 5
    endif
    assign pri_pct = pri_value | times: 100.0 | divided_by: pri_max
  -%}
  {%- style -%}
    .pri {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      margin: 4px 0 10px;
      font-size: 13px;
      line-height: 1;
      text-decoration: none;
      color: #444;
    }
    .pri__stars {
      position: relative;
      display: inline-block;
      white-space: nowrap;
    }
    .pri__stars-bg,
    .pri__stars-fg {
      display: block;
      letter-spacing: 1px;
      font-size: 15px;
    }
    .pri__stars-bg {
      color: #d8d2c6;
    }
    .pri__stars-fg {
      position: absolute;
      top: 0;
      left: 0;
      overflow: hidden;
      color: #d4a017;
    }
    .pri__count {
      color: #666;
    }
    a.pri:hover .pri__count {
      text-decoration: underline;
    }
  {%- endstyle -%}
  <a
    class="pri"
    href="#judgeme_product_reviews"
    aria-label="{{ 'accessibility.star_reviews_info' | t: rating_value: pri_value, rating_max: pri_max }} — {{ pri_count }} {{ 'accessibility.total_reviews' | t }}"
  >
    <span class="pri__stars" aria-hidden="true">
      <span class="pri__stars-bg">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
      <span class="pri__stars-fg" style="width: {{ pri_pct }}%;">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
    </span>
    <span class="pri__count" aria-hidden="true">
      {{- pri_value }}/{{ pri_max }} ({{ pri_count }})
    </span>
  </a>
{%- endif -%}
