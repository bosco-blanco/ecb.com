{%- comment -%}
  "Si te gusta este vino, tambien te gustara..." como seccion propia.

  El snippet `related-products` se renderizaba a pelo dentro de
  main-product.liquid, justo debajo de la columna de compra, y en movil se
  colaba entre el boton de comprar y la ficha de cata. Como seccion se puede
  colocar al final de la pagina desde el editor, que es donde va lo
  recomendado. El snippet no cambia.
{%- endcomment -%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  @media screen and (max-width: 749px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top | times: 0.6 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.6 | round: 0 }}px;
    }
  }
{%- endstyle -%}

<div class="ecdb-relacionados section-{{ section.id }}-padding">
  {%- render 'related-products', product: product -%}
</div>

{% schema %}
{
  "name": "Si te gusta este vino",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Recomendaciones por bodega, D.O., uva y precio. Si no encuentra ninguna, no se ve nada."
    },
    {
      "type": "header",
      "content": "Márgenes"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Margen superior",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Margen inferior",
      "default": 0
    }
  ],
  "enabled_on": {
    "templates": ["product"]
  },
  "presets": [
    {
      "name": "Si te gusta este vino"
    }
  ]
}
{% endschema %}
