  #vpp-{{ SID }} .vpp-single-inner { max-width:720px; margin:0 auto; text-align:center; }
  #vpp-{{ SID }} .vpp-single-inner .vpp-eyebrow { margin-bottom:20px; }
  #vpp-{{ SID }} .vpp-single-inner h2 { font-size:clamp(34px,3.6vw,54px); line-height:1.05; margin:0 0 26px; }
  #vpp-{{ SID }} .vpp-single-inner p { font-size:15.5px; line-height:1.8; color:#4c473c; margin:0 0 18px; }
  #vpp-{{ SID }} .vpp-single-inner p:last-child { margin-bottom:0; }

  /* La filoxera (fondo oscuro) */
  #vpp-{{ SID }} .vpp-dark { position:relative; background:#191712; color:#FBF8EE; padding:120px 8vw; overflow:hidden; }
  #vpp-{{ SID }} .vpp-dark .vpp-dark-grid { max-width:1300px; margin:0 auto; display:grid; grid-template-columns:minmax(0,1fr) minmax(0,0.85fr); gap:7vw; align-items:center; }
  #vpp-{{ SID }} .vpp-dark .vpp-eyebrow { color:#E4C989; margin-bottom:22px; }
  #vpp-{{ SID }} .vpp-dark h2 { font-size:clamp(34px,4vw,58px); line-height:1.06; margin:0 0 28px; color:#FBF8EE; max-width:16ch; }
  #vpp-{{ SID }} .vpp-dark p { font-size:16px; line-height:1.8; color:rgba(251,248,238,0.82); max-width:48ch; margin:0 0 18px; }
  #vpp-{{ SID }} .vpp-dark p:last-child { margin-bottom:0; }
  #vpp-{{ SID }} .vpp-dark .vpp-dark-media { position:relative; aspect-ratio:4/5; border-radius:2px; overflow:hidden; }
  #vpp-{{ SID }} .vpp-dark .vpp-dark-media > img { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; }

  /* Los vinos */
  #vpp-{{ SID }} .vpp-wines { background:#FBF8EE; padding:110px 8vw 60px; }
  #vpp-{{ SID }} .vpp-wines-head { text-align:center; margin-bottom:70px; }
  #vpp-{{ SID }} .vpp-wines-head .vpp-eyebrow { margin-bottom:18px; }
  #vpp-{{ SID }} .vpp-wines-head h2 { font-size:clamp(36px,4.2vw,58px); line-height:1.06; margin:0 auto; max-width:22ch; }
  #vpp-{{ SID }} .vpp-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(230px,1fr)); gap:28px; max-width:1280px; margin:0 auto 70px; }
  @media (min-width:1080px) {
    #vpp-{{ SID }} .vpp-grid { grid-template-columns:repeat(5,minmax(0,1fr)); max-width:1500px; gap:24px; }
  }
  #vpp-{{ SID }} .vpp-card { display:flex; flex-direction:column; text-decoration:none; color:inherit; border-radius:2px; transition:transform .18s ease, box-shadow .18s ease; }
  #vpp-{{ SID }} .vpp-card:hover { transform:translateY(-4px); box-shadow:0 20px 40px rgba(25,23,18,0.14); }
  #vpp-{{ SID }} .vpp-card figure { margin:0 0 26px; }
  #vpp-{{ SID }} .vpp-card .vpp-shot { aspect-ratio:3/4; position:relative; overflow:hidden; }
  #vpp-{{ SID }} .vpp-card .vpp-shot > img { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; }
  #vpp-{{ SID }} .vpp-badge-slot { display:flex; justify-content:center; margin-bottom:16px; min-height:26px; }
  #vpp-{{ SID }} .vpp-badge { display:inline-block; align-self:center; font-size:10px; letter-spacing:0.14em; text-transform:uppercase; padding:6px 16px; border-radius:20px; }
  #vpp-{{ SID }} .vpp-card h3 { font-weight:600; font-size:26px; line-height:1.15; text-align:center; margin:0 0 8px; min-height:2.3em; display:flex; align-items:center; justify-content:center; }
  #vpp-{{ SID }} .vpp-card .vpp-tagline { font-family:'Cormorant Garamond',serif; font-style:italic; font-size:15.5px; line-height:1.35; text-align:center; margin:0 0 22px; min-height:2.7em; display:flex; align-items:center; justify-content:center; }
  #vpp-{{ SID }} .vpp-specs { margin-bottom:22px; min-height:164px; }
  #vpp-{{ SID }} .vpp-spec { display:flex; justify-content:space-between; padding:11px 2px; font-size:12.5px; min-height:38px; box-sizing:border-box; }
  #vpp-{{ SID }} .vpp-spec span:first-child { text-transform:uppercase; letter-spacing:0.1em; font-size:10.5px; }
  #vpp-{{ SID }} .vpp-price { text-align:center; margin-top:auto; }
  #vpp-{{ SID }} .vpp-price-row { display:flex; align-items:baseline; justify-content:center; gap:10px; }
  #vpp-{{ SID }} .vpp-was { font-size:13px; text-decoration:line-through; }
  #vpp-{{ SID }} .vpp-now { font-family:'Cormorant Garamond',serif; font-size:34px; font-weight:600; }
  #vpp-{{ SID }} .vpp-tbd { font-family:'Cormorant Garamond',serif; font-size:18px; font-style:italic; }
  #vpp-{{ SID }} .vpp-unit { font-size:10.5px; letter-spacing:0.1em; text-transform:uppercase; margin-top:4px; }
  #vpp-{{ SID }} .vpp-cta-mini { font-size:10.5px; letter-spacing:0.14em; text-transform:uppercase; margin-top:16px; padding-top:14px; }
  #vpp-{{ SID }} .vpp-atc-form { margin-top:18px; display:block; }
  #vpp-{{ SID }} .vpp-atc { width:100%; cursor:pointer; padding:14px 18px; font-family:'Instrument Sans',sans-serif; font-size:11.5px; font-weight:600; letter-spacing:0.12em; text-transform:uppercase; border-radius:2px; transition:opacity .18s ease; position:relative; }
  #vpp-{{ SID }} .vpp-atc:hover { opacity:.85; }
  #vpp-{{ SID }} .vpp-atc[disabled], #vpp-{{ SID }} .vpp-atc[aria-disabled="true"] { opacity:.4; cursor:not-allowed; }
  #vpp-{{ SID }} .vpp-atc.loading { color:transparent; }
  #vpp-{{ SID }} .vpp-atc-form .product-form__error-message-wrapper { font-size:11px; color:#b3261e; margin-bottom:8px; text-align:center; }
  #vpp-{{ SID }} .vpp-ficha-link { display:inline-block; margin-top:12px; font-size:10.5px; letter-spacing:0.14em; text-transform:uppercase; text-decoration:none; }

  /* Reserva + cuenta atrás */
  #vpp-{{ SID }} .vpp-reserva { display:flex; flex-direction:column; align-items:center; text-align:center; padding:60px 4vw 50px; border-top:1px solid rgba(25,23,18,0.1); }
  #vpp-{{ SID }} .vpp-reserva h3 { font-size:clamp(28px,3.4vw,42px); line-height:1.1; max-width:22ch; margin:0 0 18px; }
  #vpp-{{ SID }} .vpp-reserva h3 em { font-style:italic; color:#8A6D2F; }
  #vpp-{{ SID }} .vpp-reserva > p { font-size:15px; line-height:1.7; color:#4c473c; max-width:54ch; margin:0 0 40px; }
  #vpp-{{ SID }} .vpp-countdown { display:flex; align-items:stretch; margin-bottom:38px; }
  #vpp-{{ SID }} .vpp-cd-cell { padding:0 24px; border-right:1px solid rgba(25,23,18,0.18); }
  #vpp-{{ SID }} .vpp-cd-cell:last-child { border-right:0; }
  #vpp-{{ SID }} .vpp-cd-num { display:block; font-family:'Cormorant Garamond',serif; font-size:38px; font-weight:500; line-height:1; font-variant-numeric:tabular-nums; }
  #vpp-{{ SID }} .vpp-cd-cell:last-child .vpp-cd-num { color:#8A6D2F; }
  #vpp-{{ SID }} .vpp-cd-lbl { font-size:10px; letter-spacing:0.18em; text-transform:uppercase; color:#6d675a; }
  #vpp-{{ SID }} .vpp-btn { text-decoration:none; background:#191712; color:#FBF8EE; border:1px solid #191712; padding:18px 52px; font-family:'Instrument Sans',sans-serif; font-size:13px; font-weight:600; letter-spacing:0.14em; text-transform:uppercase; border-radius:2px; display:inline-block; transition:background .18s ease, color .18s ease; }
  #vpp-{{ SID }} .vpp-btn:hover { background:#C2A15B; border-color:#C2A15B; color:#191712; }
  #vpp-{{ SID }} .vpp-fineprint { font-size:12.5px; color:#6d675a; margin-top:16px; }

  @media (max-width:749px) {
    #vpp-{{ SID }} .vpp-split, #vpp-{{ SID }} .vpp-dark .vpp-dark-grid { grid-template-columns:1fr; }
    #vpp-{{ SID }} .vpp-split { min-height:0; }
    #vpp-{{ SID }} .vpp-media { min-height:60vw; }
    #vpp-{{ SID }} .vpp-copy { padding:56px 8vw; }
    #vpp-{{ SID }} .vpp-dark { padding:72px 8vw; }
    #vpp-{{ SID }} .vpp-hero { height:82vh; }
    #vpp-{{ SID }} .vpp-wines { padding:72px 6vw 40px; }
    /* La media va debajo del texto en móvil salvo el bloque château (media primero) */
    #vpp-{{ SID }} .vpp-split--media-first .vpp-media { order:-1; }
  }
</style>

<div id="vpp-{{ SID }}">

  {%- comment -%} ══ Bienvenida premium (socio aprobado) ══ {%- endcomment -%}
  <div class="vpp-welcome">
    {{ welcome }}{% if customer and customer.first_name != blank %}, <b>{{ customer.first_name }}</b>{% endif %} · eres miembro de las Ventas Privadas de <b>En Copa de Balón</b>
    {%- if info_line != blank -%}<span class="vpp-info">{{ info_line }}</span>{%- endif -%}
  </div>

  {%- comment -%} ══ HERO ══ {%- endcomment -%}
  <section class="vpp-hero">
    <img src="{{ 'vp-julio2026-fachada.jpg' | asset_url }}" alt="Pazo de la Cuesta" loading="eager" fetchpriority="high">
    <div class="vpp-scrim"></div>
    <div class="vpp-hero-inner">
      <div class="vpp-place">Pazo de la Cuesta · San Clodio, Ribeira Sacra</div>
      <div>
        <h1>El château gallego que la filoxera <em>no pudo tocar</em></h1>
        <p>La bodega familiar más antigua de Galicia, en pie desde 1608, guarda dos parcelas de viñas centenarias que sobrevivieron a la plaga que arrasó los viñedos de Europa. De ahí sale un vino que hoy es, sencillamente, imposible de replicar — y cuya otra joya, el Brancellao 2023, acaba de ganar el único oro para un tinto de Ribeira Sacra en los Decanter World Wine Awards.</p>
      </div>
    </div>
  </section>

  {%- comment -%} ══ DESDE 1608 ══ {%- endcomment -%}
  <section id="historia-{{ SID }}" class="vpp-split">
    <div class="vpp-copy">
      <div class="vpp-eyebrow">Desde 1608</div>
      <h2>Catorce generaciones, una misma tierra</h2>
      <p>En San Clodio, a orillas del Sil, la familia Bellod elabora vino desde 1608. Es la bodega familiar más antigua de Galicia, y hoy la dirige la decimocuarta generación de propietarios del pazo.</p>
      <p>Cuatro siglos sin vender la finca, sin romper la cadena. No es una bodega que se fundó pensando en crecer rápido — es una que sigue en pie porque nunca se marchó.</p>
    </div>
    <div class="vpp-media">
      <img src="{{ 'vp-julio2026-aereo.jpg' | asset_url }}" alt="Pazo de la Cuesta, vista aérea" loading="lazy">
    </div>
  </section>

  {%- comment -%} ══ EL CHÂTEAU GALLEGO (media a la izquierda) ══ {%- endcomment -%}
  <section class="vpp-split vpp-split--media-first">
    <div class="vpp-media">
      <img src="{{ 'vp-julio2026-barricas.jpg' | asset_url }}" alt="Bodega de barricas, Pazo de la Cuesta" loading="lazy">
    </div>
    <div class="vpp-copy">
      <div class="vpp-eyebrow">El primer château gallego</div>
      <h2>Como en Burdeos, pero en Galicia</h2>
      <p>Pazo de la Cuesta trabaja al estilo de los grandes châteaux de Burdeos: la bodega rodeada de sus propios viñedos, la uva vendimiada y prensada en la misma finca, sin pasar por manos ajenas. En Galicia, eso sigue siendo raro.</p>
      <p>Ya en 1862 fueron los primeros de todo el norte de España en etiquetar sus propios vinos — cuando casi nadie en la región firmaba lo que embotellaba.</p>
    </div>
  </section>

  {%- comment -%} ══ LA FILOXERA ══ {%- endcomment -%}
  <section id="filoxera-{{ SID }}" class="vpp-dark">
    <div class="vpp-dark-grid">
      <div>
        <div class="vpp-eyebrow">La plaga que cambió el vino europeo</div>
        <h2>Lo que la filoxera no llegó a matar</h2>
        <p>A finales del siglo XIX, una plaga llegada de América destruyó casi todos los viñedos de Europa. La solución, la única que funcionó, fue injertar las variedades europeas sobre raíz americana. Desde entonces, casi ninguna viña del continente crece sobre su propia raíz.</p>
        <p>En el Pazo de la Cuesta sobreviven dos parcelas diminutas, a orillas del Sil, plantadas en 1860 — antes de que la plaga cruzara el Atlántico. Son cepas de Garnacha Tintorera, una variedad llegada originalmente del sur de Francia, y crecen todavía sobre pie franco: su propia raíz, nunca injertada.</p>
        <p>Esto no se puede fabricar ni acelerar. No existe forma de "plantar" una viña prefiloxérica hoy — o la tierra la conserva desde antes de la plaga, o ya no existe. Por eso el vino que sale de ahí se embotella en una edición numerada: cuando se acaba, se acaba.</p>
      </div>
      <div class="vpp-dark-media">
        <img src="{{ 'vp-julio2026-cepa.jpg' | asset_url }}" alt="Cepa prefiloxérica de Garnacha Tintorera, plantada en 1860" loading="lazy">
      </div>
    </div>
  </section>

  {%- comment -%}
    ══ LA OTRA RAREZA DE LA CASA ══
    Antes era un split texto/foto, pero no hay foto real del racimo de
    Brancellao (quedaba el placeholder en blanco). Se convierte en un
    bloque centrado a ancho completo y se amplía el texto: ya no habla
    solo de la Brancellao, también de lo particular de la Garnacha
    Tintorera prefiloxérica y, en general, de que cada una de las 5
    cajas de esta selección tiene detrás algo que no se repite fácil.
  {%- endcomment -%}
  <section class="vpp-single">
    <div class="vpp-single-inner">
      <div class="vpp-eyebrow">La otra rareza de la casa</div>
      <h2>Una uva que casi desapareció</h2>
      <p>La Brancellao es autóctona de Galicia y estuvo a punto de perderse del todo: racimos pequeños, piel fina, rendimientos tan bajos que casi ninguna bodega quería seguir plantándola. Hoy la recupera un puñado de bodegas en Ribeira Sacra y sigue siendo, de largo, una de las variedades gallegas más difíciles de encontrar embotellada en solitario.</p>
      <p>La Garnacha Tintorera prefiloxérica de la casa es un caso todavía más singular: nace de las mismas cepas de pie franco plantadas en 1860, nunca injertadas, que sobrevivieron a la plaga que arrasó casi todos los viñedos de Europa. No hay forma de reponerla — cuando se acaba esa edición numerada, se acaba.</p>
      <p>Y no son las únicas con algo que contar: el Brancellao con el único oro para un tinto de Ribeira Sacra en los Decanter World Wine Awards, el Mencía elegido mejor tinto español en el International Wine Challenge, el Godello de viñedo histórico, el Brancas con su ensamblaje de cuatro variedades autóctonas. Cada caja de esta selección tiene detrás algo que no se repite fácil.</p>
    </div>
  </section>

  {%- comment -%} ══ LOS VINOS (bloques) ══ {%- endcomment -%}
  <section id="vinos-{{ SID }}" class="vpp-wines">
    <div class="vpp-wines-head">
      <div class="vpp-eyebrow">{{ section.settings.wines_eyebrow | default: 'Cinco vinos, una sola reserva de julio' }}</div>
      <h2>{{ section.settings.wines_title | default: 'Lo raro y lo casi imposible' }}</h2>
    </div>

    <div class="vpp-grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'wine' -%}
          {%- liquid
            if block.settings.featured
              assign bg = '#191712'
              assign fg = '#FBF8EE'
              assign fgMuted = 'rgba(251,248,238,0.55)'
              assign rule = 'rgba(251,248,238,0.18)'
              assign accent = '#E4C989'
              assign pad = '36px 30px'
            else
              assign bg = '#FBF8EE'
              assign fg = '#191712'
              assign fgMuted = '#8b8577'
              assign rule = 'rgba(25,23,18,0.16)'
              assign accent = '#8A6D2F'
              assign pad = '0px'
            endif

            assign img = ''
            if block.settings.bottle_image != blank
              assign img = block.settings.bottle_image | image_url: width: 900
            elsif block.settings.image_url != blank
              assign img = block.settings.image_url
            elsif block.settings.asset_name != blank
              assign img = block.settings.asset_name | asset_url
            endif

            assign href = block.settings.product_url | default: '#'
          -%}
          {%- assign has_link = false -%}
          {%- if href != '#' and href != blank -%}{%- assign has_link = true -%}{%- endif -%}
          <div class="vpp-card" style="background:{{ bg }}; padding:{{ pad }};" {{ block.shopify_attributes }}>
            <figure>
              <div class="vpp-shot">
                {%- if has_link -%}<a href="{{ href }}" aria-label="{{ block.settings.name | escape }}" style="position:absolute; inset:0; z-index:1;"></a>{%- endif -%}
                {%- if img != blank -%}
                  <img src="{{ img }}" alt="{{ block.settings.name | escape }}" loading="lazy">
                {%- else -%}
                  <div class="vpp-ph">{{ block.settings.placeholder | default: 'Foto · botella' }}</div>
                {%- endif -%}
              </div>
            </figure>

            {%- comment -%} Slot de badge siempre reservado (aunque esté vacío) para que el título arranque a la misma altura en todas las tarjetas. {%- endcomment -%}
            <div class="vpp-badge-slot">
              {%- if block.settings.badge != blank -%}
                <div class="vpp-badge" style="border:1px solid {{ accent }}; color:{{ accent }};">{{ block.settings.badge }}</div>
              {%- endif -%}
            </div>

            {%- if has_link -%}
              <h3 style="color:{{ fg }};"><a href="{{ href }}" style="color:inherit; text-decoration:none;">{{ block.settings.name }}</a></h3>
            {%- else -%}
              <h3 style="color:{{ fg }};">{{ block.settings.name }}</h3>
            {%- endif -%}
            {%- if block.settings.tagline != blank -%}
              <p class="vpp-tagline" style="color:{{ fgMuted }};">{{ block.settings.tagline }}</p>
            {%- endif -%}

            {%- assign has_specs = false -%}
            {%- for i in (1..4) -%}
              {%- assign k = 'spec_' | append: i | append: '_k' -%}
              {%- assign v = 'spec_' | append: i | append: '_v' -%}
              {%- if block.settings[k] != blank and block.settings[v] != blank -%}{%- assign has_specs = true -%}{%- endif -%}
            {%- endfor -%}
            {%- if has_specs -%}
              <div class="vpp-specs" style="border-top:1px solid {{ rule }};">
                {%- for i in (1..4) -%}
                  {%- assign k = 'spec_' | append: i | append: '_k' -%}
                  {%- assign v = 'spec_' | append: i | append: '_v' -%}
                  {%- if block.settings[k] != blank and block.settings[v] != blank -%}
                    <div class="vpp-spec" style="border-bottom:1px solid {{ rule }}; color:{{ fg }};"><span style="color:{{ fgMuted }};">{{ block.settings[k] }}</span><span>{{ block.settings[v] }}</span></div>
                  {%- endif -%}
                {%- endfor -%}
              </div>
            {%- endif -%}

            <div class="vpp-price">
              {%- if block.settings.price_now != blank -%}
                <div class="vpp-price-row">
                  {%- if block.settings.price_was != blank -%}<span class="vpp-was" style="color:{{ fgMuted }};">{{ block.settings.price_was }}</span>{%- endif -%}
                  <span class="vpp-now" style="color:{{ fg }};">{{ block.settings.price_now }}</span>
                </div>
                {%- if block.settings.unit != blank -%}<div class="vpp-unit" style="color:{{ accent }};">{{ block.settings.unit }}</div>{%- endif -%}
              {%- elsif block.settings.price_tbd != blank -%}
                <div class="vpp-tbd" style="color:{{ accent }};">{{ block.settings.price_tbd }}</div>
                {%- if block.settings.unit != blank -%}<div class="vpp-unit" style="color:{{ fgMuted }};">{{ block.settings.unit }}</div>{%- endif -%}
              {%- endif -%}
              {%- if block.settings.variant_id != blank -%}
                {%- comment -%}
                  <product-form> es el web component real del tema (assets/product-form.js,
                  ya cargado en páginas vía layout/theme.liquid). Intercepta el submit,
                  hace el add-to-cart por fetch a routes.cart_add_url y abre el
                  cart-drawer/cart-notification existente del header — sin recargar
                  ni sacar al cliente de esta página.
                {%- endcomment -%}
                <product-form class="vpp-atc-form" style="border-top:1px solid {{ rule }}; padding-top:16px;">
                  <div class="product-form__error-message-wrapper" role="alert" hidden>
                    <span class="product-form__error-message"></span>
                  </div>
                  <form action="{{ routes.cart_add_url }}" method="post" enctype="multipart/form-data" class="form">
                    <input type="hidden" name="id" value="{{ block.settings.variant_id }}" class="product-variant-id">
                    <input type="hidden" name="quantity" value="1">
                    <button type="submit" name="add" class="vpp-atc" style="background:{{ fg }}; color:{{ bg }}; border:1px solid {{ fg }};">
                      <span>Agregar al carrito</span>
                      <div class="loading-overlay__spinner hidden">
                        <svg aria-hidden="true" focusable="false" role="presentation" class="spinner" viewBox="0 0 66 66" xmlns="http://www.w3.org/2000/svg">
                          <circle class="path" fill="none" stroke-width="6" cx="33" cy="33" r="30"></circle>
                        </svg>
                      </div>
                    </button>
                  </form>
                </product-form>
                {%- if has_link -%}<a class="vpp-ficha-link" href="{{ href }}" style="color:{{ accent }};">Ver ficha →</a>{%- endif -%}
              {%- else -%}
                <div class="vpp-cta-mini" style="color:{{ accent }}; border-top:1px solid {{ rule }};">{% if href != '#' and href != blank %}Ver ficha y comprar →{% else %}Próximamente{% endif %}</div>
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- comment -%} ══ RESERVA + CUENTA ATRÁS ══ {%- endcomment -%}
    <div id="reserva-{{ SID }}" class="vpp-reserva">
      <h3>Reserva tu caja: <em>la oportunidad de probar algo único</em></h3>
      <p>{{ section.settings.reserva_text | default: 'Añade al carrito todas las cajas que quieras — pedimos directamente a la bodega según lo reservado. Cerramos la venta el 28 de julio, los envíos empiezan el 20 de julio y llegan en 24-48 horas.' }}</p>

      <div class="vpp-countdown" data-vpp-countdown data-deadline="{{ deadline }}">
        <div class="vpp-cd-cell"><span class="vpp-cd-num" data-cd="days">--</span><span class="vpp-cd-lbl">días</span></div>
        <div class="vpp-cd-cell"><span class="vpp-cd-num" data-cd="hours">--</span><span class="vpp-cd-lbl">horas</span></div>
        <div class="vpp-cd-cell"><span class="vpp-cd-num" data-cd="mins">--</span><span class="vpp-cd-lbl">min</span></div>
        <div class="vpp-cd-cell"><span class="vpp-cd-num" data-cd="secs">--</span><span class="vpp-cd-lbl">seg</span></div>
      </div>

      <a class="vpp-btn" href="#vinos-{{ SID }}">Elegir mi caja</a>
      {%- if info_line != blank -%}<div class="vpp-fineprint">{{ info_line }}</div>{%- endif -%}
    </div>
  </section>
</div>

<script>
  (function () {
    var root = document.getElementById('vpp-{{ SID }}');
    if (!root) return;
    var cd = root.querySelector('[data-vpp-countdown]');
    if (!cd) return;
    var deadline = new Date(cd.getAttribute('data-deadline')).getTime();
    var els = {
      days: cd.querySelector('[data-cd="days"]'),
      hours: cd.querySelector('[data-cd="hours"]'),
      mins: cd.querySelector('[data-cd="mins"]'),
      secs: cd.querySelector('[data-cd="secs"]')
    };
    function pad(n) { return String(n).padStart(2, '0'); }
    function tick() {
      var diff = Math.max(0, deadline - Date.now());
      els.days.textContent = pad(Math.floor(diff / 86400000));
      els.hours.textContent = pad(Math.floor(diff / 3600000) % 24);
      els.mins.textContent = pad(Math.floor(diff / 60000) % 60);
      els.secs.textContent = pad(Math.floor(diff / 1000) % 60);
    }
    tick();
    setInterval(tick, 1000);
  })();
</script>

{%- endif -%}

