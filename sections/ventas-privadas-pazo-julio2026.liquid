{%- comment -%}
  Ventas Privadas · Pazo de la Cuesta — Julio 2026 (En Copa de Balón)

  Página inmersiva para el socio APROBADO (tag 'preventa'). Portada desde el
  mockup aprobado (design/ventas-privadas-julio-2026/mockup-final.dc.html).

  · Header y footer: se usan los REALES del tema (carrito/cuenta/búsqueda).
    Esta sección arranca en el Hero y termina en la reserva — NO replica el
    header/footer del mockup.
  · Paleta propia de esta landing (edición especial tipo "château"),
    intencionadamente distinta de los tokens de marca del resto del sitio:
      fondo #FBF8EE · tinta #191712 · panel claro #F3EFE1
      acento oliva #8A6D2F · acento dorado #E4C989 (sobre fondo oscuro)
  · Los vinos son BLOQUES de sección (editables desde el editor de temas).
  · Cuenta atrás: cierre 28-jul-2026 23:59 (configurable abajo).
{%- endcomment -%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Instrument+Sans:wght@400;500;600&display=swap" rel="stylesheet">

{%- comment -%}
  Gate: esta sección SOLO se renderiza para el socio aprobado (tag 'preventa').
  En el editor de temas (request.design_mode) se muestra siempre para poder editarla.
{%- endcomment -%}
{%- liquid
  assign is_member = false
  if customer and customer.tags contains 'preventa'
    assign is_member = true
  endif
-%}
{%- if is_member or request.design_mode -%}

{%- liquid
  assign SID = section.id | replace: '-', '' | replace: '_', ''
  assign deadline = section.settings.deadline | default: '2026-07-28T23:59:59'
  assign info_line = section.settings.info_line
  assign welcome = section.settings.welcome_line | default: 'Bienvenido/a al círculo'
-%}

<style>
  #vpp-{{ SID }} {
    background:#FBF8EE; color:#191712;
    font-family:'Instrument Sans',sans-serif; -webkit-font-smoothing:antialiased;
    overflow-x:hidden;
  }
  #vpp-{{ SID }} h1, #vpp-{{ SID }} h2, #vpp-{{ SID }} h3 { font-family:'Cormorant Garamond',serif; font-weight:500; }
  #vpp-{{ SID }} a { color:#191712; }
  #vpp-{{ SID }} ::selection { background:#E8DCB8; }
  #vpp-{{ SID }} .vpp-serif { font-family:'Cormorant Garamond',serif; }

  /* Banda de bienvenida premium */
  #vpp-{{ SID }} .vpp-welcome {
    background:#191712; color:#FBF8EE; text-align:center;
    font-size:11px; letter-spacing:0.14em; text-transform:uppercase;
    padding:10px 16px; line-height:1.5;
  }
  #vpp-{{ SID }} .vpp-welcome b { color:#E4C989; font-weight:600; letter-spacing:0.14em; }
  #vpp-{{ SID }} .vpp-welcome .vpp-info { display:block; color:rgba(251,248,238,0.6); font-size:10px; letter-spacing:0.16em; margin-top:4px; }

  /* Hero */
  #vpp-{{ SID }} .vpp-hero { position:relative; height:92vh; min-height:600px; }
  #vpp-{{ SID }} .vpp-hero > img { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; }
  #vpp-{{ SID }} .vpp-hero .vpp-scrim { position:absolute; inset:0; background:linear-gradient(180deg, rgba(25,23,18,0.15), rgba(25,23,18,0.55)); }
  #vpp-{{ SID }} .vpp-hero .vpp-hero-inner { position:absolute; inset:0; display:flex; flex-direction:column; justify-content:space-between; padding:6vh 6vw; }
  #vpp-{{ SID }} .vpp-hero .vpp-place { font-size:11px; letter-spacing:0.24em; text-transform:uppercase; color:#FBF8EE; opacity:0.85; }
  #vpp-{{ SID }} .vpp-hero h1 { margin:0; font-size:clamp(46px,7vw,104px); line-height:1.02; color:#FBF8EE; max-width:20ch; text-shadow:0 4px 30px rgba(0,0,0,0.3); }
  #vpp-{{ SID }} .vpp-hero h1 em { font-style:italic; color:#E4C989; }
  #vpp-{{ SID }} .vpp-hero p { font-size:16.5px; line-height:1.7; color:rgba(251,248,238,0.88); max-width:52ch; margin:26px 0 0; }

  /* Bloques narrativos partidos */
  #vpp-{{ SID }} .vpp-split { display:grid; grid-template-columns:minmax(0,1fr) minmax(0,1fr); min-height:78vh; }
  #vpp-{{ SID }} .vpp-copy { display:flex; flex-direction:column; justify-content:center; align-items:center; text-align:center; padding:80px 7vw; }
  #vpp-{{ SID }} .vpp-media { position:relative; min-height:420px; }
  #vpp-{{ SID }} .vpp-media > img { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; }
  #vpp-{{ SID }} .vpp-eyebrow { font-size:10.5px; letter-spacing:0.26em; text-transform:uppercase; color:#8A6D2F; font-weight:600; margin-bottom:20px; }
  #vpp-{{ SID }} .vpp-copy h2 { font-size:clamp(34px,3.6vw,54px); line-height:1.05; margin:0 0 22px; }
  #vpp-{{ SID }} .vpp-copy p { font-size:15.5px; line-height:1.75; color:#4c473c; max-width:44ch; margin:0 0 16px; }
  #vpp-{{ SID }} .vpp-copy p:last-child { margin-bottom:0; }

  /* Placeholder de imagen (cuando no hay foto) */
  #vpp-{{ SID }} .vpp-ph { position:absolute; inset:0; display:flex; align-items:center; justify-content:center; text-align:center; background:#EDE7D4; color:#8b8577; font-size:12px; letter-spacing:0.08em; padding:20px; }

  /* Bloque narrativo centrado a ancho completo (sin foto) — "La otra rareza de la casa" */
