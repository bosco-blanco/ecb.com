{%- comment -%}
  Banner "Bajate Copa Academy y aprende a catar ya".

  Cierra la ficha de producto conectando lo que el cliente acaba de leer
  ("Asi lo catamos") con el sitio de donde sale: la app.

  Sin URL de App Store el bloque NO se pinta en la tienda. Un boton de
  descarga que no lleva a ninguna parte es peor que no tener boton. En el
  editor de temas si se ve, con un aviso, para poder colocarlo antes de
  tener la URL.
{%- endcomment -%}

{%- liquid
  assign url_app_store = section.settings.url_app_store
  assign hay_url = false
  if url_app_store != blank
    assign hay_url = true
  endif
-%}

{%- if hay_url or request.design_mode -%}
  {{ 'ficha-producto-ecdb.css' | asset_url | stylesheet_tag }}
  {%- render 'ecdb-fuentes' -%}

  {%- style -%}
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }

    @media screen and (max-width: 749px) {
      .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top | times: 0.6 | round: 0 }}px;
        padding-bottom: {{ section.settings.padding_bottom | times: 0.6 | round: 0 }}px;
      }
    }
  {%- endstyle -%}

  <div class="page-width section-{{ section.id }}-padding">
    <section
      class="ecdb-fp ecdb-academy"
      aria-labelledby="ecdb-academy-titulo-{{ section.id }}"
    >
      <span class="ecdb-academy__blob ecdb-academy__blob--1" aria-hidden="true"></span>
      <span class="ecdb-academy__blob ecdb-academy__blob--2" aria-hidden="true"></span>

      <div class="ecdb-academy__texto">
        {%- if section.settings.kicker != blank -%}
          <p class="ecdb-academy__kicker">{{ section.settings.kicker | escape }}</p>
        {%- endif -%}

        <h2 class="ecdb-academy__titulo" id="ecdb-academy-titulo-{{ section.id }}">
          {{ section.settings.titulo | escape }}
        </h2>

        {%- if section.settings.cuerpo != blank -%}
          <p class="ecdb-academy__cuerpo">{{ section.settings.cuerpo | escape }}</p>
        {%- endif -%}

        <div class="ecdb-academy__acciones">
          {%- if hay_url -%}
            <a
              class="ecdb-academy__boton"
              href="{{ url_app_store }}"
              target="_blank"
              rel="noopener"
            >
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M16.4 12.6c0-2.4 2-3.6 2.1-3.7-1.1-1.7-2.9-1.9-3.5-1.9-1.5-.2-2.9.9-3.7.9-.8 0-1.9-.9-3.2-.8-1.6 0-3.1 1-4 2.4-1.7 3-.4 7.3 1.2 9.7.8 1.2 1.8 2.5 3 2.4 1.2 0 1.7-.8 3.2-.8s1.9.8 3.2.8c1.3 0 2.2-1.2 3-2.4.9-1.3 1.3-2.6 1.3-2.7 0 0-2.6-1-2.6-3.9zM14 5.4c.7-.8 1.1-1.9 1-3-1 0-2.1.7-2.8 1.5-.6.7-1.2 1.8-1 2.9 1.1.1 2.1-.5 2.8-1.4z"/></svg>
              {{ section.settings.texto_boton | escape }}
            </a>
          {%- else -%}
            {%- comment -%} Solo visible en el editor de temas. {%- endcomment -%}
            <p class="ecdb-academy__nota">
              Pega la URL de App Store en los ajustes para que este bloque se publique.
            </p>
          {%- endif -%}

          {%- if section.settings.nota != blank -%}
            <span class="ecdb-academy__nota">{{ section.settings.nota | escape }}</span>
          {%- endif -%}
        </div>
      </div>

      {%- if section.settings.mostrar_logo -%}
        <div class="ecdb-academy__medallon">
          <img
            src="{{ 'copa-academy-crop.png' | asset_url }}"
            alt="Copa Academy"
            width="1835"
            height="1388"
            loading="lazy"
          >
        </div>
      {%- endif -%}
    </section>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Banner Copa Academy",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Sin URL de App Store el bloque no se publica: aquí en el editor sí se ve, pero en la tienda no aparece."
    },
    {
      "type": "url",
      "id": "url_app_store",
      "label": "URL de App Store"
    },
    {
      "type": "text",
      "id": "texto_boton",
      "label": "Texto del botón",
      "default": "App Store"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Antetítulo",
      "default": "Nuestra app"
    },
    {
      "type": "text",
      "id": "titulo",
      "label": "Título",
      "default": "Bájate Copa Academy y aprende a catar ya"
    },
    {
      "type": "textarea",
      "id": "cuerpo",
      "label": "Texto",
      "default": "Las fichas de cata que ves aquí salen de la app. Cata tus vinos, guarda tu bodega y aprende con cursos cortos, gratis."
    },
    {
      "type": "text",
      "id": "nota",
      "label": "Nota junto al botón",
      "info": "Quítala si prefieres no anunciar todavía la versión de Android.",
      "default": "Gratis · Pronto en Android"
    },
    {
      "type": "checkbox",
      "id": "mostrar_logo",
      "label": "Mostrar el logo en círculo",
      "default": true
    },
    {
      "type": "header",
      "content": "Márgenes"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Margen superior",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Margen inferior",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Banner Copa Academy"
    }
  ]
}
{% endschema %}
